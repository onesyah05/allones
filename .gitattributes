# Normalize text and keep LF where it matters (scripts, workflows, Go).
* text=auto eol=lf

*.go      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
Makefile  text eol=lf
VERSION   text eol=lf

*.cmd     text eol=crlf

# Lockfiles and binaries
web/bun.lock        -diff
*.woff2   binary
*.png     binary
*.ico     binary
